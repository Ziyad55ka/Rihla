# Copy this file to backend/.env. The API runs with these defaults.
APP_ENV=development
# Origins are a JSON array; keep the scheme, host, and port exact.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional for /health. Required for /api/me and /api/profile.
# Find the URL and publishable key in the Supabase project connection/API settings.
# Use the SAME project URL and publishable key as frontend/.env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# WARNING: SECRET. This key bypasses all Row Level Security and can read every
# member's private data. Keep it only in backend/.env. Never commit it, log it,
# share it, or put it in any frontend file or VITE_ variable. If it leaks, rotate
# it in Supabase at once. Used only to fetch proposal generation inputs.
# Holds either key type: sb_secret_... or a legacy service_role key.
SUPABASE_SECRET_KEY=

# Optional: persistent login-limit metadata. Empty uses backend/.local/login-limits.sqlite3.
# Store on a local disk; separate hosts need a shared limiter before deployment.
LOGIN_LIMIT_DB=

# Optional for the API; required only by trip research. Keep real keys in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Optional cheaper model for source extraction/activity ranking; evaluate accuracy
# before enabling. Empty keeps GEMINI_MODEL. Use an available Gemini 3.x text model.
GEMINI_EXTRACTOR_MODEL=
# Wait before the single retry after a Gemini quota limit or outage.
GEMINI_RETRY_DELAY_SECONDS=20
# How much Gemini thinks before answering: minimal, low, medium or high. Reading
# search results is simple, so low is much faster. Empty uses the model default.
GEMINI_EXTRACT_THINKING=low
GEMINI_PLANNER_THINKING=
TAVILY_API_KEY=
# Round-trip fares. Without a key, or if it fails, flights use the Tavily search.
IGNAV_API_KEY=
FLIGHT_PRICE_PROVIDER=ignav
# basic costs 1 Tavily credit per search; advanced costs 2.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
# Empty uses backend/.local/search-cache.sqlite3.
SEARCH_CACHE_DB=
SEARCH_CACHE_TTL_HOURS=24

# Any long random text, kept secret. Empty means saved proposals are not reused
# after the backend restarts.
PROPOSALS_HASH_KEY=

# true: generation returns the saved proposals in app/data/demo_proposals.json, with no
# Gemini or Tavily calls. Use for presentations only; results are marked as demo.
PROPOSALS_DEMO_MODE=false

# Lowest budget per trip day before generation stops without any outside request.
MIN_BUDGET_SAR_PER_DAY=250
# Unchanged inputs reuse saved proposals for this long.
SAVED_PROPOSALS_TTL_HOURS=24

# Most Gemini requests one generation may start. Successful proposals are still returned.
MAX_GEMINI_CALLS_PER_GENERATION=7

# Whether an Ignav amount covers the whole party (total) or one person (per_person).
IGNAV_PRICE_SCOPE=total
# Flight and hotel sources in preferred order. Only ones switched on are asked.
FLIGHT_PROVIDERS=["tripcom","ignav"]
HOTEL_PROVIDERS=["serpapi","tripcom"]
# Google Hotels through SerpApi: a real price per night in SAR with a seller link
# (Booking.com when Google lists it). Free plan: 250 searches a month. Empty = off.
SERPAPI_API_KEY=
# One more request per city to find Booking.com's own price and link.
SERPAPI_HOTEL_DETAILS=true
# Optional structured dated events. Get your own Discovery API key; keep it here
# on the backend only. Empty = existing guide research. No reservations are made.
TICKETMASTER_API_KEY=
# Academic, non-commercial use only. See docs/ai-proposals.md before switching on.
TRIPCOM_ENABLED=false
# How long the page says a checked booking link should work, in minutes.
LINK_VALID_MINUTES=15
# Above this gap between sources, the airline's own price decides.
PRICE_CONFLICT_PERCENT=10
# A gap above this between a search and its seller is logged.
PRICE_GAP_LOG_PERCENT=5
# An agent cheaper than the airline by this much is offered as an option.
AGENT_CHEAPER_PERCENT=5
# Free city photos from Wikimedia.
PLACE_IMAGES_ENABLED=true
# How long generation may reuse a fare. Refresh and book never reuse one.
FLIGHT_CACHE_MINUTES=15
# Limits that protect the free requests. At a limit, people get a search link.
MEMBER_FLIGHT_ACTIONS_PER_HOUR=5
TRIP_REQUESTS_PER_DAY=30
DAILY_REQUESTS_PER_SOURCE=200
# How long a flight button stays off after each press.
REFRESH_COOLDOWN_MINUTES=2
# Advisory review reminder from the oldest verified fare timestamp, not a fare hold.
PRICE_REVIEW_MINUTES=15
# A price is fresh below the first number of hours, and old above the second.
PRICE_FRESH_HOURS=3
PRICE_STALE_HOURS=24
# US-13: a general daily allowance per person for meals and small expenses, in SAR.
# It has no source, so the page always marks it Unconfirmed.
MEALS_PER_DAY_SAR=150
# A night's hotel when no search or planner price was found, in SAR. Marked
# Unconfirmed, so a stay is never counted as free in the budget check.
HOTEL_FALLBACK_NIGHT_SAR=400
# Two separate bookings must save this much, and may take only this much longer.
SPLIT_MIN_SAVING_PERCENT=15
SPLIT_MAX_EXTRA_DURATION_PERCENT=30

# Fare-first generation (on whenever IGNAV_API_KEY is set): only destinations with a
# bookable flight from every departure city are researched.
# A trip never starts sooner than this many days from today.
MIN_DEPARTURE_LEAD_DAYS=3
# Destinations Gemini suggests at once; the first 3 with flights are kept.
PLANNER_OPTION_COUNT=5
# Departure days tried around the planned one when it has no flights.
FLIGHT_DATE_SHIFTS=[1,-1,2,-2]

# Paid model access through OpenRouter. When set, every model call uses it and
# GEMINI_API_KEY is ignored. Use a normal API key (openrouter.ai/settings/keys),
# not a Management key: Management keys cannot call models.
OPENROUTER_API_KEY=
# Empty uses "google/" + GEMINI_MODEL; GEMINI_EXTRACTOR_MODEL still applies to extraction.
OPENROUTER_MODEL=google/gemini-3.6-flash
# Pin one provider, or leave empty to let OpenRouter pick.
OPENROUTER_PROVIDER=google-ai-studio
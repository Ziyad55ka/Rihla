# Copy this file to backend/.env. The API runs with these defaults.
APP_ENV=development
# Origins are a JSON array; keep the scheme, host, and port exact.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Optional for /health. Required for /api/me and /api/profile.
# Find the URL and publishable key in the Supabase project connection/API settings.
# Use the SAME project URL and publishable key as frontend/.env.local.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# WARNING: SECRET. This key bypasses all Row Level Security and can read every
# member's private data. Keep it only in backend/.env. Never commit it, log it,
# share it, or put it in any frontend file or VITE_ variable. If it leaks, rotate
# it in Supabase at once. Used only to fetch proposal generation inputs.
# Holds either key type: sb_secret_... or a legacy service_role key.
SUPABASE_SECRET_KEY=

# Optional: persistent login-limit metadata. Empty uses backend/.local/login-limits.sqlite3.
# Store on a local disk; separate hosts need a shared limiter before deployment.
LOGIN_LIMIT_DB=

# Optional for the API; required only by trip research. Keep real keys in backend/.env.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
# Wait before the single retry after a Gemini quota limit or outage.
GEMINI_RETRY_DELAY_SECONDS=20
TAVILY_API_KEY=
# Round-trip fares. Without a key, or if it fails, flights use the Tavily search.
IGNAV_API_KEY=
FLIGHT_PRICE_PROVIDER=ignav
# basic costs 1 Tavily credit per search; advanced costs 2.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
# Empty uses backend/.local/search-cache.sqlite3.
SEARCH_CACHE_DB=
SEARCH_CACHE_TTL_HOURS=24

# Any long random text, kept secret. Empty means saved proposals are not reused
# after the backend restarts.
PROPOSALS_HASH_KEY=

# true: generation returns the saved proposals in app/data/demo_proposals.json, with no
# Gemini or Tavily calls. Use for presentations only; results are marked as demo.
PROPOSALS_DEMO_MODE=false

# Lowest budget per trip day before generation stops without any outside request.
MIN_BUDGET_SAR_PER_DAY=250
# Unchanged inputs reuse saved proposals for this long.
SAVED_PROPOSALS_TTL_HOURS=24

# Most Gemini requests one generation may start. Successful proposals are still returned.
MAX_GEMINI_CALLS_PER_GENERATION=7
